AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# OAuth Client ID/Secret của Google Cloud Console (consent screen: workspace @senzu.co.jp)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
